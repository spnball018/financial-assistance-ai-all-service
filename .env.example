# Copy to .env (gitignored). docker compose reads it automatically.
# Postgres password; only applied when the postgres volume is created for the first time.
POSTGRES_PASSWORD=postgres

# Public deployment (docker compose --profile public up -d): the hostname Caddy serves over HTTPS.
# Must be a domain name (Google sign-in does not accept a bare IP), pointing at this server.
# DOMAIN=money.example.com

# Home server via Cloudflare Tunnel instead (docker compose --profile tunnel up -d): the tunnel token
# from Cloudflare Zero Trust > Networks > Tunnels. The public hostname is set there, not here.
# CLOUDFLARE_TUNNEL_TOKEN=

# Nightly pg_dump into ./data/backups (profiles public and tunnel): days to keep
# BACKUP_KEEP_DAYS=14
