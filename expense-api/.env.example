# Fernet key for encrypting stored secrets (e.g. KTC PDF password).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Categorizer adapter: gemini | vertex | none
# Unset = gemini if GEMINI_API_KEY is set, otherwise none (Merchant Memory only)
CATEGORIZER=
CATEGORIZE_BATCH_SIZE=25
# Model for both gemini and vertex; check it is still offered before changing
GEMINI_MODEL=gemini-3.5-flash-lite

# CATEGORIZER=gemini
GEMINI_API_KEY=

# CATEGORIZER=vertex (auth: gcloud auth application-default login, or GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Below this confidence a category becomes Uncategorized
AI_CONFIDENCE_THRESHOLD=0.7

# Host headers the API accepts (DNS-rebinding guard). Add your hostname if you serve it under another name.
# ALLOWED_HOSTS=localhost,127.0.0.1,expense-api
