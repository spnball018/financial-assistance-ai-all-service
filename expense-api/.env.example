# Fernet key for encrypting stored secrets (e.g. KTC PDF password).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Gemini API key (swap to Vertex later via GOOGLE_GENAI_USE_VERTEXAI=true + project/location)
GEMINI_API_KEY=
# Model for categorization; check it is still offered before changing (models.list)
GEMINI_MODEL=gemini-2.5-flash

# Below this confidence a category becomes Uncategorized
AI_CONFIDENCE_THRESHOLD=0.7
