# Fernet key for encrypting stored secrets (e.g. KTC PDF password).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Categorizer adapter: gemini | vertex | none
# Unset = gemini if GEMINI_API_KEY is set, otherwise none (Merchant Memory only)
CATEGORIZER=
CATEGORIZE_BATCH_SIZE=25
# Model for both gemini and vertex; check it is still offered before changing
GEMINI_MODEL=gemini-3.5-flash-lite

# CATEGORIZER=gemini
GEMINI_API_KEY=

# CATEGORIZER=vertex (auth: gcloud auth application-default login, or GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Below this confidence a category becomes Uncategorized
AI_CONFIDENCE_THRESHOLD=0.7

# Days of email the first sync of each source pulls (default 90). Only affects sources not synced yet.
# SYNC_FIRST_RUN_DAYS=180

# Where receipt photos are stored (default: <repo>/data/receipts; docker-compose sets /data/receipts)
# RECEIPTS_DIR=

# Host headers the API accepts (DNS-rebinding guard). Add your public hostname.
# ALLOWED_HOSTS=localhost,127.0.0.1,expense-api,money.example.com

# ── Sign-in ───────────────────────────────────────────────────────────────
# google (default) | off. off skips sign-in for local development and only answers localhost.
AUTH_MODE=google
# Always admins, created on first sign-in. Other people are added by an admin in Settings > ผู้ใช้.
ADMIN_EMAILS=
# Where the browser opens the web UI; Google redirects back to PUBLIC_BASE_URL/api/auth/callback.
# https here also makes the session cookie Secure.
PUBLIC_BASE_URL=http://localhost:3000
# Google Cloud > APIs & Services > Credentials > OAuth client ID > "Web application"
# (not gmail-service's credentials.json). Authorized redirect URI: PUBLIC_BASE_URL + /api/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# SESSION_DAYS=30
